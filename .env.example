# Microsoft Entra — zie docs/entra-instellen.md
# Vul deze in op de VPS in een bestand .env (dat bestand hoort niet in git).
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=http://localhost:3000/auth/callback

# Waar in OneDrive de twee ruimtes staan
RUIMTE_WERK=Bestandskluis/Werk
RUIMTE_PRIVE=Bestandskluis/Prive

# Waar de index en cache terechtkomen
DATA_MAP=./data

# Poort waarop de app luistert
POORT=3000
